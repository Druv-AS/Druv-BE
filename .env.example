# Environment for the Dhruv backend. Copy and fill in per environment; never commit real
# values. In production, StartupConfigValidator refuses to boot if any of the security
# settings below are missing or unsafe.

# ----------------------------------------------------------------- profile
# 'dev' seeds demo accounts and logs at DEBUG. 'prod' enforces the checks below.
SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------- database
# Must be a durable PostgreSQL instance. The in-memory H2 default is development-only and
# discards every account on restart; the prod profile rejects it.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Flyway owns the schema; Hibernate only verifies it matches.
JPA_DDL_AUTO=validate

DB_POOL_MAX=10
DB_POOL_MIN=2

# -------------------------------------------------------------------- CORS
# Exact frontend origins, comma-separated. No wildcards: the session cookie requires
# credentialed CORS, and the spec forbids '*' there.
CORS_ALLOWED_ORIGINS=https://app.dhruv.example.com

# Exact origins allowed to open the co-study WebSocket. The browser same-origin policy
# does not cover WebSockets, so this server-side check is the only control.
WEBSOCKET_ALLOWED_ORIGINS=https://app.dhruv.example.com

# ----------------------------------------------------------------- session
# Must be true in production so the cookie is never sent over plaintext HTTP.
SESSION_COOKIE_SECURE=true

# 'Lax' when the SPA and API share a registrable domain (preferred).
# 'None' only when they are on unrelated domains; requires SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=Lax

SESSION_TIMEOUT=12h

# -------------------------------------------------------------- rate limits
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW=300

# Enable ONLY behind a proxy that overwrites X-Forwarded-For (most PaaS load balancers do).
# If enabled without such a proxy, clients can forge the header and bypass the limit.
TRUST_FORWARDED_FOR=true

# ------------------------------------------------------------------- misc
PORT=8080
LOG_LEVEL=INFO
H2_CONSOLE_ENABLED=false
